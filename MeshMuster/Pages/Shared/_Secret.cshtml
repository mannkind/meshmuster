@model MeshMuster.Pages.Models.SecretView
@if (Model.Value.Length == 0)
{
    <span class="muted">&mdash;</span>
}
else
{
    <div class="secret" data-secret="@Model.Value">
        <details class="secret-disclosure">
            <summary aria-label="Show or hide @Model.Name">
                <span class="secret-mask mono">••••••••••••</span>
                <span class="secret-show btn-small">reveal</span>
                <span class="secret-hide btn-small">hide</span>
            </summary>
            <span class="value mono">@Model.Value</span>
        </details>
        <button type="button" class="btn-small secret-copy" aria-label="Copy @Model.Name">copy</button>
    </div>
}
