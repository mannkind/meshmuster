# MeshMuster runs behind an OAuth proxy; it has no login of its own.
LISTEN_ADDR=:8080
STATE_PATH=./state
DATABASE_PATH=
# Required. 32 bytes of base64; encrypts private keys and admin passwords in the database.
# Generate with `openssl rand -base64 32`. Lose it and the secrets are gone with it.
SECRET_KEY=
# Optional. Raises the GitHub API rate limit from 60/hr to 5000/hr. Not needed for four repos.
GITHUB_TOKEN=
# Optional override, used by the test suite to point at a local stub.
GITHUB_API_BASE_URL=
# Optional override for the official KISS firmware catalog.
FLASHER_CONFIG_URL=
POLL_INTERVAL_HOURS=6
POLL_ON_STARTUP=true
TRUSTED_PROXIES=
TRUSTED_NETWORKS=
