{
  "name": "meshmuster-web",
  "private": true,
  "description": "Browser scripts for MeshMuster. Compiled to MeshMuster/wwwroot by tsc.",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
